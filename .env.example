# Modelo de variáveis no ambiente do Contraponto
TELEGRAM_BOT_TOKEN=seu_token_telegram_aqui
OPENAI_API_KEY=
GOOGLE_FACT_CHECK_KEY=sua_chave_google_fact_check_aqui
TAVILY_API_KEY=sua_chave_tavily_aqui
MAX_CLAIMS_PER_MESSAGE=5

# Opcional: Lista de IDs de grupos permitidos para o bot atuar (separados por vírgula).
# Deixe em branco para executar apenas no privado; nenhum grupo será autorizado.
# Exemplo: AUTHORIZED_GROUPS=-1001234567890,-1009876543210
AUTHORIZED_GROUPS=
