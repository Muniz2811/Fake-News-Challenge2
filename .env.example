# Modelo de variáveis no ambiente do Contraponto
TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
# LLM local pelo endpoint compatível com OpenAI do Ollama (opcional).
# Nativo: http://localhost:11434/v1
# Docker Desktop: http://host.docker.internal:11434/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen3:8b
LLM_TIMEOUT_SECONDS=90
LLM_MAX_TOKENS=1024
MAX_EVIDENCES_PER_CLAIM=2
MAX_EVIDENCE_SNIPPET_CHARS=600
GOOGLE_FACT_CHECK_KEY=
TAVILY_API_KEY=
MAX_CLAIMS_PER_MESSAGE=5

# Score linguístico: TF-IDF (padrão), BERTimbau + regressão ou BERTimbau + MLP.
# Para usar BERTimbau, instale requirements-bertimbau.txt e mantenha os
# checkpoints e relatórios gerados pelo experimento neste computador.
LANGUAGE_RISK_BACKEND=tfidf
BERTIMBAU_LOGREG_METRICS_PATH=data/processed/language_risk/bertimbau/metrics.json
BERTIMBAU_MLP_METRICS_PATH=data/processed/language_risk/bertimbau/metrics_mlp.json
BERTIMBAU_MODEL_DIR=models/language_risk/bertimbau_base
BERTIMBAU_DEVICE=auto

# Opcional: Lista de IDs de grupos permitidos para o bot atuar (separados por vírgula).
# Deixe em branco para executar apenas no privado; nenhum grupo será autorizado.
# Exemplo: AUTHORIZED_GROUPS=-1001234567890,-1009876543210
AUTHORIZED_GROUPS=
